# Configuração do PromptShield. O instalador cria o arquivo .env a partir deste e preenche as senhas e chaves com valores aleatórios.
# Guarde uma cópia do .env em lugar seguro (ele tem as senhas e a chave dos textos originais). NÃO envie ao fornecedor.
PS_VERSION={{VERSION}}

POSTGRES_USER=promptshield
POSTGRES_DB=promptshield
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
LOCAL_AUTH_SECRET=
# Chave dos textos originais (opcional por empresa). Sem ela, textos originais cifrados NÃO podem ser lidos: guarde-a separada do backup do banco.
ORIGINAL_TEXT_MASTER_KEY=

# Endereço do console e acesso. Por padrão só o próprio servidor alcança (127.0.0.1). Para a equipe acessar, use um proxy reverso com HTTPS (veja o LEIA-ME).
PUBLIC_BASE_URL=http://localhost:3000
WEB_BIND=127.0.0.1
WEB_PORT=3000
API_BIND=127.0.0.1
API_PORT=8000
CORS_ALLOWED_ORIGINS=

# Validação da licença com o fornecedor (não mude; vêm no pacote)
LICENSE_SERVER_URL={{LICENSE_URL}}
LICENSE_PUBLIC_KEY={{PUBLIC_KEY}}
