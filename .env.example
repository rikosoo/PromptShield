# Copie para .env (make up faz isso). Valores abaixo são só para desenvolvimento local.
POSTGRES_USER=promptshield
POSTGRES_PASSWORD=troque-isto-localmente
POSTGRES_DB=promptshield
# senha do papel restrito promptshield_app, que a API usa em runtime (sem BYPASSRLS)
APP_DB_PASSWORD=troque-isto-tambem
# As portas só escutam em 127.0.0.1 (padrão seguro). Só mude BIND_ADDR sabendo o que faz: com OIDC_MODE=mock, quem alcançar a API emite token.
# WEB_BIND=127.0.0.1
# API_BIND=127.0.0.1
# O banco nunca é exposto. Para abrir o console/API use infra/expose.sh (limite o acesso por IP no firewall!).
API_PORT=8000
WEB_PORT=3000

# Login do console: off (padrão seguro) | mock (só desenvolvimento) | oidc
OIDC_MODE=off
# OIDC_MODE=mock exige um segredo de pelo menos 32 caracteres; habilita POST /dev/token
OIDC_MOCK_SECRET=
# Login do console com E-MAIL E SENHA (recomendado fora de desenvolvimento). Para ligar: LOCAL_AUTH=true, LOCAL_AUTH_SECRET com 32+ caracteres
# (openssl rand -hex 32), AUTH_MODE=local (mais abaixo) e OIDC_MODE=off (o modo mock emite sessão para qualquer e-mail e contorna a senha).
# Política: 8+ caracteres com minúscula, maiúscula, número e caractere especial. O primeiro administrador ganha senha pelo comando
#   docker compose exec api python -m app.cli set-password --email admin@empresa.com.br --generate
LOCAL_AUTH=false
LOCAL_AUTH_SECRET=
# Texto original (opcional por tenant): 32 bytes em base64 urlsafe.
# Gere com: python3 -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ORIGINAL_TEXT_MASTER_KEY=

# Extensão do navegador: origem permitida no CORS, ex.: chrome-extension://<ID da extensão>. Vazio = nenhuma.
CORS_ALLOWED_ORIGINS=

# Console web. AUTH_MODE=mock só em desenvolvimento (combine com OIDC_MODE=mock na API); AUTH_MODE=local: e-mail e senha (combine com LOCAL_AUTH=true na API).
AUTH_MODE=mock
PUBLIC_BASE_URL=http://localhost:3000
# AUTH_MODE=oidc (não testado contra um provedor real); OIDC_AUDIENCE da API = OIDC_CLIENT_ID
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=

# Worker (Etapa 7): e-mail de alertas e relatórios. Sem SMTP_HOST o envio por e-mail falha com mensagem clara.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=promptshield@localhost

# Licenciamento on-premise (docs/licenciamento.md). off = SaaS/desenvolvimento, nada muda.
LICENSE_MODE=off
# LICENSE_SERVER_URL=https://licencas.seudominio.com.br   # serviço de licenças do fornecedor (https em produção)
# LICENSE_PUBLIC_KEY=                                      # chave PÚBLICA do fornecedor (32 bytes em base64 urlsafe), fixada na instalação
# LICENSE_ALLOW_HTTP=false                                 # só teste local
# Só no servidor do FORNECEDOR (docker compose --profile vendor ...): gere com `python -m lic_service.cli gen-key`
# LICENSING_DB_PASSWORD=
# LICENSE_SIGNING_KEY=

# Inference hooks do Claude Enterprise (Etapa 8): valores padrão; só mude se souber o motivo
# INFERENCE_HOOK_BUDGET_MS=3000

# Etapa 9: limites e observabilidade (valores padrão; ver docs/operacao.md)
# RATE_LIMIT_KEY_PER_MINUTE=6000
# RATE_LIMIT_USER_PER_MINUTE=600
# METRICS_TOKEN=            # defina um token longo para habilitar /metrics; vazio = rota desligada
